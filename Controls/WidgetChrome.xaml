<UserControl x:Class="Kobold.Controls.WidgetChrome"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             TextOptions.TextFormattingMode="Display">

    <!-- Content-agnostic widget shell: rounded border + shadow, a 40px header
         (title / lock / pin / drag / right-click) and the content slots. Visual
         values and DynamicResource keys mirror FolderWidget.xaml's panel shell. -->
    <Grid>
        <Border x:Name="Shell" x:FieldModifier="public"
                CornerRadius="16"
                BorderThickness="1" BorderBrush="{DynamicResource Kobold.Brush.PanelBorder}"
                RenderOptions.BitmapScalingMode="HighQuality"
                SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="25" ShadowDepth="8" Opacity="0.5" Color="Black" RenderingBias="Quality"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header - drag handle for moving the panel; right-click opens the widget menu -->
                <Border x:Name="Header" x:FieldModifier="public" Grid.Row="0" CornerRadius="16,16,0,0" Padding="12,0"
                        Cursor="Hand"
                        MouseLeftButtonDown="Header_MouseLeftButtonDown"
                        MouseMove="Header_MouseMove"
                        MouseLeftButtonUp="Header_MouseLeftButtonUp"
                        MouseRightButtonDown="Header_MouseRightButtonDown">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ContentPresenter x:Name="HeaderLeading" x:FieldModifier="public" Grid.Column="0" VerticalAlignment="Center"/>
                        <!-- Title area: the caption plus the optional title-menu
                             chevron. The chevron stays collapsed unless a host
                             sets TitleMenuEnabled, so folder/todo keep their
                             plain title. Its own press is handled there, so a
                             header drag never starts from it. -->
                        <Grid x:Name="TitleGroup" Grid.Column="1" Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TitleText" x:FieldModifier="public" Grid.Column="0" FontSize="13" FontWeight="SemiBold"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <!-- The chevron sits in a 24x24 transparent border so
                                 the hit target is a comfortable square, not just
                                 the glyph run. The glyph's ink comes from
                                 ApplyTheme (one source of truth). -->
                            <Border x:Name="TitleChevron" x:FieldModifier="public" Grid.Column="1"
                                    Width="24" Height="24" Background="Transparent" Cursor="Hand"
                                    VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Margin="6,0,0,0" Visibility="Collapsed"
                                    MouseLeftButtonDown="TitleChevron_MouseLeftButtonDown"
                                    MouseLeftButtonUp="TitleChevron_MouseLeftButtonUp"
                                    MouseEnter="TitleChevron_MouseEnter"
                                    MouseLeave="TitleChevron_MouseLeave">
                                <TextBlock x:Name="TitleChevronGlyph" Text="▾" FontSize="12" Padding="2,0"
                                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ContentPresenter x:Name="HeaderTrailing" x:FieldModifier="public" Grid.Column="2" VerticalAlignment="Center"/>

                        <!-- Lock toggle (next to pin) -->
                        <Border x:Name="LockButton" x:FieldModifier="public" Grid.Column="3"
                                Width="24" Height="24" CornerRadius="6"
                                Background="Transparent" Cursor="Hand"
                                VerticalAlignment="Center" Margin="8,0,0,0"
                                MouseLeftButtonDown="LockButton_MouseLeftButtonDown">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="LockButtonScale" x:FieldModifier="public" ScaleX="1" ScaleY="1" CenterX="12" CenterY="12"/>
                            </Border.RenderTransform>
                            <Canvas Width="14" Height="14" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Path x:Name="LockIcon" x:FieldModifier="public"
                                      Data="M2,5 L2,4 C2,1.5 4,0 6,0 C8,0 10,1.5 10,4 L10,5 L8,5 L8,4 C8,2.5 7,1.5 6,1.5 C5,1.5 4,2.5 4,4 L4,5 Z M1,5 L11,5 L11,12 L1,12 Z M5.5,7.5 L6.5,7.5 L6.5,9.5 L5.5,9.5 Z"
                                      Fill="{DynamicResource Kobold.Brush.IconFill}" Stroke="{DynamicResource Kobold.Brush.IconStroke}" StrokeThickness="0.5"/>
                            </Canvas>
                        </Border>

                        <!-- Pin button -->
                        <Border x:Name="PinButton" x:FieldModifier="public" Grid.Column="4"
                                Width="24" Height="24" CornerRadius="6"
                                Background="Transparent" Cursor="Hand"
                                VerticalAlignment="Center" Margin="8,0,0,0"
                                MouseLeftButtonDown="PinButton_MouseLeftButtonDown">
                            <Canvas Width="14" Height="14" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <!-- Pin Icon (pushpin shape) -->
                                <Path x:Name="PinIcon" x:FieldModifier="public"
                                      Data="M4,0 L10,0 L10,2 L9,2 L9,6 L11,8 L11,9 L8,9 L8,14 L6,14 L6,9 L3,9 L3,8 L5,6 L5,2 L4,2 Z"
                                      Fill="{DynamicResource Kobold.Brush.IconFill}" Stroke="{DynamicResource Kobold.Brush.IconStroke}" StrokeThickness="0.5"
                                      RenderTransformOrigin="0.5,0.5">
                                    <Path.RenderTransform>
                                        <RotateTransform x:Name="PinIconRotation" x:FieldModifier="public" Angle="45"/>
                                    </Path.RenderTransform>
                                </Path>
                            </Canvas>
                        </Border>
                    </Grid>
                </Border>

                <ContentPresenter x:Name="ContentHost" x:FieldModifier="public" Grid.Row="1"/>
                <ContentPresenter x:Name="FooterHost" x:FieldModifier="public" Grid.Row="2"/>
            </Grid>
        </Border>

        <!-- Native resize affordances on top of the shell: four 5 DIP
             invisible bands along the edges plus a 16x16 bottom-right grip.
             The layer Grid carries no Background, so it never blocks the
             content; only the bands themselves hit-test. The grip comes last
             so the bottom-right corner is its hit target. -->
        <Grid x:Name="ResizeLayer" x:FieldModifier="public">
            <Border x:Name="ResizeLeft" x:FieldModifier="public" Width="5" HorizontalAlignment="Left" Background="Transparent"
                    Cursor="SizeWE" Tag="Left" MouseLeftButtonDown="ResizeBand_MouseLeftButtonDown"
                    MouseMove="ResizeBand_MouseMove" MouseLeftButtonUp="ResizeBand_MouseLeftButtonUp"/>
            <Border x:Name="ResizeRight" x:FieldModifier="public" Width="5" HorizontalAlignment="Right" Background="Transparent"
                    Cursor="SizeWE" Tag="Right" MouseLeftButtonDown="ResizeBand_MouseLeftButtonDown"
                    MouseMove="ResizeBand_MouseMove" MouseLeftButtonUp="ResizeBand_MouseLeftButtonUp"/>
            <Border x:Name="ResizeTop" x:FieldModifier="public" Height="5" VerticalAlignment="Top" Background="Transparent"
                    Cursor="SizeNS" Tag="Top" MouseLeftButtonDown="ResizeBand_MouseLeftButtonDown"
                    MouseMove="ResizeBand_MouseMove" MouseLeftButtonUp="ResizeBand_MouseLeftButtonUp"/>
            <Border x:Name="ResizeBottom" x:FieldModifier="public" Height="5" VerticalAlignment="Bottom" Background="Transparent"
                    Cursor="SizeNS" Tag="Bottom" MouseLeftButtonDown="ResizeBand_MouseLeftButtonDown"
                    MouseMove="ResizeBand_MouseMove" MouseLeftButtonUp="ResizeBand_MouseLeftButtonUp"/>
            <Border x:Name="ResizeGrip" x:FieldModifier="public" Width="16" Height="16"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="Transparent"
                    Cursor="SizeNWSE" Tag="BottomRight"
                    MouseLeftButtonDown="ResizeBand_MouseLeftButtonDown"
                    MouseMove="ResizeBand_MouseMove" MouseLeftButtonUp="ResizeBand_MouseLeftButtonUp"
                    MouseEnter="ResizeGrip_MouseEnter" MouseLeave="ResizeGrip_MouseLeave">
                <!-- Three low-contrast diagonal lines in the theme's muted ink;
                     the hover handlers brighten them. -->
                <Canvas x:Name="ResizeGripGlyph" Width="16" Height="16" Opacity="0.35" IsHitTestVisible="False">
                    <Line X1="9" Y1="15" X2="15" Y2="9" Stroke="{DynamicResource Kobold.Brush.TextMuted}" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    <Line X1="5" Y1="15" X2="15" Y2="5" Stroke="{DynamicResource Kobold.Brush.TextMuted}" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    <Line X1="1" Y1="15" X2="15" Y2="1" Stroke="{DynamicResource Kobold.Brush.TextMuted}" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Canvas>
            </Border>
        </Grid>
    </Grid>
</UserControl>
