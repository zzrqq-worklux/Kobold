<local:WidgetWindowBase x:Class="Kobold.Controls.WidgetGroupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Kobold.Controls"
        Title="WidgetGroupWindow"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="False" ResizeMode="NoResize" ShowInTaskbar="False"
        Width="760" Height="540"
        PreviewMouseLeftButtonDown="Window_PreviewMouseLeftButtonDown"
        PreviewKeyDown="Window_PreviewKeyDown"
        KeyDown="Window_KeyDown"
        TextOptions.TextFormattingMode="Display">

    <!-- The shared shell. The 32px bare tab row is installed above its 40px
         header by the code-behind; each member's real view lives in its own
         slot inside ContentHost and only the active one is visible. -->
    <local:WidgetChrome x:Name="GroupChrome" x:FieldModifier="public"/>
</local:WidgetWindowBase>
