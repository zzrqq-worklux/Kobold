<Window x:Class="Kobold.Controls.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kobold Island"
        WindowStyle="None" AllowsTransparency="True" Background="{x:Null}"
        Topmost="True" ResizeMode="NoResize" ShowInTaskbar="False"
        ShowActivated="False" Focusable="False"
        UseLayoutRounding="True"
        WindowStartupLocation="Manual"
        Width="332" Height="72">

    <Window.Resources>
        <!-- Scroll hint for the widget tiles: a slim floating pill, no track,
             inset from both ends. 3px/28% at rest, 4px/68% under the pointer or
             while dragged. The code fades it out (Opacity) once the user stops
             interacting, and disables hit testing with it so it never blocks
             the tiles. Height is the hit area, not the visible pill. -->
        <Style x:Key="IslandScrollBarStyle" TargetType="ScrollBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" Orientation="Horizontal" Margin="8,0,8,0">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbBody" Height="3" CornerRadius="1.5"
                                                        VerticalAlignment="Center" Opacity="0.28"
                                                        Background="{DynamicResource Kobold.Brush.IslandForeground}"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbBody" Property="Height" Value="4"/>
                                                        <Setter TargetName="ThumbBody" Property="CornerRadius" Value="2"/>
                                                        <Setter TargetName="ThumbBody" Property="Opacity" Value="0.68"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbBody" Property="Height" Value="4"/>
                                                        <Setter TargetName="ThumbBody" Property="CornerRadius" Value="2"/>
                                                        <Setter TargetName="ThumbBody" Property="Opacity" Value="0.68"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!--
        The window keeps a FIXED size; only the inner Content animates.
        Animating window geometry would issue a Win32 SetWindowPos every frame
        and make the layered window stutter. Window.Background is null so the
        empty area stays click-through - only Content is hit-testable.
    -->
    <Grid>
        <Grid x:Name="IslandBody"
              HorizontalAlignment="Center" VerticalAlignment="Top"
              Width="300" Height="10"
              Background="Transparent"
              MouseEnter="Window_MouseEnter"
              MouseLeave="Window_MouseLeave"
              PreviewMouseWheel="IslandBody_PreviewMouseWheel">

            <Rectangle x:Name="PillShape"
                       Width="120" Height="8"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       RadiusX="4" RadiusY="4"
                       Fill="{DynamicResource Kobold.Brush.IslandBackground}"
                       Stroke="{DynamicResource Kobold.Brush.IslandBorder}" StrokeThickness="1"
                       Cursor="Hand"
                       MouseLeftButtonDown="Pill_MouseLeftButtonDown"
                       MouseMove="Pill_MouseMove"
                       MouseLeftButtonUp="Pill_MouseLeftButtonUp">
                <Rectangle.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.35" Direction="270"/>
                </Rectangle.Effect>
            </Rectangle>

            <!-- Three parts: fixed desktop entry | scrollable widget tiles |
                 fixed add + settings. Only the middle scrolls and it is capped
                 (IslandLayout), so the fixed entries can never scroll away. -->
            <StackPanel x:Name="IslandRow"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="Hidden">

                <!-- Desktop entry: single click toggles desktop icons, double click opens the folder -->
                <Border x:Name="DesktopTile" Width="44" Height="44" CornerRadius="8"
                        Background="Transparent" Cursor="Hand" Margin="0,0,8,0">
                    <Viewbox Width="30" Height="30">
                        <Grid>
                            <!-- Classic glyph -->
                            <Canvas x:Name="DesktopTileClassic" Width="24" Height="24">
                                <Rectangle Canvas.Left="2" Canvas.Top="3" Width="20" Height="14"
                                           RadiusX="2.5" RadiusY="2.5"
                                           Stroke="{DynamicResource Kobold.Brush.IslandForeground}" StrokeThickness="1.8"/>
                                <Rectangle Canvas.Left="10" Canvas.Top="17" Width="4" Height="4" Fill="{DynamicResource Kobold.Brush.IslandForeground}"/>
                                <Rectangle Canvas.Left="6" Canvas.Top="21" Width="12" Height="1.8"
                                           RadiusX="0.9" RadiusY="0.9" Fill="{DynamicResource Kobold.Brush.IslandForeground}"/>
                                <Line x:Name="DesktopSlash" X1="3.5" Y1="3.5" X2="20.5" Y2="20.5"
                                      Stroke="{DynamicResource Kobold.Brush.IslandForeground}" StrokeThickness="1.8"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Visibility="Collapsed"/>
                            </Canvas>
                            <!-- Hand-drawn glyph: the reference SVG with the wobble
                                 baked offline into fixed path data (no filter, no
                                 runtime random). Shown only in the handdrawn style. -->
                            <Canvas x:Name="DesktopTileHandDrawn" Width="24" Height="24" Visibility="Collapsed">
                                <Path Stroke="{DynamicResource Kobold.Brush.IslandForeground}" StrokeThickness="1.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Data="M 7.35,5.50 L 10.50,5.20 L 13.75,5.52 L 16.75,5.19 Q 18.76,5.29 18.72,7.42 L 18.72,10.07 L 18.80,12.73 Q 18.62,14.43 16.83,14.34 L 13.82,14.28 L 10.39,14.40 L 7.30,14.62 Q 5.49,14.38 5.54,12.83 L 5.33,9.83 L 5.41,7.05 Q 5.43,5.48 7.35,5.50 Z M 10.79,14.21 L 12.23,14.53 L 13.08,14.29 L 13.08,15.61 L 13.30,16.67 L 11.81,16.65 L 10.90,16.94 L 10.61,15.73 Z M 8.76,16.94 L 11.81,16.65 L 15.49,16.72 Q 16.11,16.67 16.26,17.70 L 16.26,17.70 Q 16.05,18.15 15.24,18.23 L 12.16,18.32 L 8.54,18.19 Q 7.96,18.09 7.90,17.63 L 7.90,17.63 Q 7.91,16.82 8.76,16.94 Z"/>
                                <Path x:Name="DesktopSlashHandDrawn" Stroke="{DynamicResource Kobold.Brush.IslandForeground}"
                                      StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M 4.19,4.30 L 9.17,8.35 L 14.82,12.40 L 19.90,16.38"
                                      Visibility="Collapsed"/>
                            </Canvas>
                        </Grid>
                    </Viewbox>
                </Border>

                <Rectangle x:Name="TileDivider" Width="1" Height="26" Margin="6,0,6,0"
                           VerticalAlignment="Center" Fill="{DynamicResource Kobold.Brush.IslandDivider}"/>

                <!-- Middle: one 44x44 tile per widget (added in code). The width is
                     set to IslandLayout.MiddleViewWidth, so the row clips here. -->
                <ScrollViewer x:Name="TileScroller"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Disabled"
                              CanContentScroll="False"
                              Focusable="False"
                              Visibility="Visible">
                    <StackPanel x:Name="TilePanel" Orientation="Horizontal"
                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </ScrollViewer>

                <!-- Settings entry: opens the settings window -->
                <Rectangle x:Name="SettingsDivider" Width="1" Height="26" Margin="6,0,6,0"
                           VerticalAlignment="Center" Fill="{DynamicResource Kobold.Brush.IslandDivider}"/>

                <!-- Add-widget entry: creates a widget with the default settings -->
                <Border x:Name="AddTile" Width="44" Height="44" CornerRadius="8"
                        Background="Transparent" Cursor="Hand" Margin="0,0,8,0">
                    <Viewbox Width="30" Height="30">
                        <Grid>
                            <!-- Classic glyph -->
                            <Canvas x:Name="AddTileClassic" Width="24" Height="24">
                                <Path Stroke="{DynamicResource Kobold.Brush.IslandForeground}" StrokeThickness="2.8"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M12,4 L12,20 M4,12 L20,12"/>
                            </Canvas>
                            <!-- Hand-drawn glyph (baked wobble, see desktop tile) -->
                            <Canvas x:Name="AddTileHandDrawn" Width="24" Height="24" Visibility="Collapsed">
                                <Path Stroke="{DynamicResource Kobold.Brush.IslandForeground}" StrokeThickness="1.7"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Data="M 7.23,11.92 L 10.31,12.23 L 13.79,12.07 L 16.66,11.77 M 11.88,7.28 L 11.80,10.17 L 11.80,13.81 L 11.81,16.65"/>
                            </Canvas>
                        </Grid>
                    </Viewbox>
                </Border>

                <Border x:Name="SettingsTile" Width="44" Height="44" CornerRadius="8"
                        Background="Transparent" Cursor="Hand">
                    <Viewbox Width="30" Height="30">
                        <Grid>
                            <!-- Classic glyph -->
                            <Canvas x:Name="SettingsTileClassic" Width="24" Height="24">
                                <!-- Gear ring (donut) -->
                                <Path Fill="{DynamicResource Kobold.Brush.IslandForeground}">
                                    <Path.Data>
                                        <GeometryGroup FillRule="EvenOdd">
                                            <EllipseGeometry Center="12,12" RadiusX="8.6" RadiusY="8.6"/>
                                            <EllipseGeometry Center="12,12" RadiusX="3.6" RadiusY="3.6"/>
                                        </GeometryGroup>
                                    </Path.Data>
                                </Path>
                                <!-- Gear teeth -->
                                <Path Stroke="{DynamicResource Kobold.Brush.IslandForeground}" StrokeThickness="2.6"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M19.4,12 L22.6,12 M17.23,17.23 L19.5,19.5 M12,19.4 L12,22.6 M6.77,17.23 L4.5,19.5 M4.6,12 L1.4,12 M6.77,6.77 L4.5,4.5 M12,4.6 L12,1.4 M17.23,6.77 L19.5,4.5"/>
                            </Canvas>
                            <!-- Hand-drawn glyph (baked wobble, see desktop tile) -->
                            <Canvas x:Name="SettingsTileHandDrawn" Width="24" Height="24" Visibility="Collapsed">
                                <Path Stroke="{DynamicResource Kobold.Brush.IslandForeground}" StrokeThickness="1.6"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Data="M 17.54,11.97 L 16.88,14.83 L 14.64,16.71 L 12.14,17.27 L 9.08,16.81 L 7.32,14.81 L 6.54,12.08 L 7.38,9.21 L 9.33,7.42 L 11.82,6.63 L 14.49,7.22 L 16.56,9.32 Z M 13.85,11.80 L 13.38,13.34 L 12.01,13.64 L 10.83,13.21 L 10.33,12.10 L 10.82,10.53 L 11.95,10.00 L 13.41,10.72 Z M 11.82,6.63 L 12.17,5.37 M 12.14,17.27 L 12.04,18.61 M 6.54,12.08 L 5.38,11.80 M 17.54,11.97 L 18.75,11.77 M 8.38,8.24 L 6.98,7.25 M 15.80,15.96 L 16.96,16.77 M 8.02,15.93 L 7.42,17.02 M 15.97,7.98 L 16.77,7.20"/>
                            </Canvas>
                        </Grid>
                    </Viewbox>
                </Border>
            </StackPanel>

            <!-- Scroll hint for the middle section: the margins span exactly
                 between the fixed parts (12px padding + desktop entry on the
                 left, 12px padding + divider + add + settings on the right).
                 Shown by the code only while the tiles overflow. -->
            <ScrollBar x:Name="TileScrollBar"
                       Orientation="Horizontal"
                       Style="{StaticResource IslandScrollBarStyle}"
                       HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
                       Margin="77,0,121,2"
                       Maximum="0" SmallChange="52" LargeChange="52"
                       Visibility="Collapsed"/>
        </Grid>
    </Grid>
</Window>
