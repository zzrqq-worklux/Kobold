<Window x:Class="Kobold.Controls.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="clr-namespace:Kobold.Controls"
        Title="Kobold Island"
        WindowStyle="None" AllowsTransparency="True" Background="{x:Null}"
        Topmost="True" ResizeMode="NoResize" ShowInTaskbar="False"
        ShowActivated="False" Focusable="False"
        UseLayoutRounding="True"
        WindowStartupLocation="Manual"
        Width="332" Height="72">

    <Window.Resources>
        <!-- Scroll hint for the widget tiles: a slim floating pill, no track,
             inset from both ends. 3px/28% at rest, 4px/68% under the pointer or
             while dragged. The code fades it out (Opacity) once the user stops
             interacting, and disables hit testing with it so it never blocks
             the tiles. Height is the hit area, not the visible pill. -->
        <Style x:Key="IslandScrollBarStyle" TargetType="ScrollBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" Orientation="Horizontal" Margin="8,0,8,0">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbBody" Height="3" CornerRadius="1.5"
                                                        VerticalAlignment="Center" Opacity="0.28"
                                                        Background="{DynamicResource Kobold.Brush.IslandForeground}"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbBody" Property="Height" Value="4"/>
                                                        <Setter TargetName="ThumbBody" Property="CornerRadius" Value="2"/>
                                                        <Setter TargetName="ThumbBody" Property="Opacity" Value="0.68"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbBody" Property="Height" Value="4"/>
                                                        <Setter TargetName="ThumbBody" Property="CornerRadius" Value="2"/>
                                                        <Setter TargetName="ThumbBody" Property="Opacity" Value="0.68"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!--
        The window keeps a FIXED size; only the inner Content animates.
        Animating window geometry would issue a Win32 SetWindowPos every frame
        and make the layered window stutter. Window.Background is null so the
        empty area stays click-through - only Content is hit-testable.
    -->
    <Grid>
        <Grid x:Name="IslandBody"
              HorizontalAlignment="Center" VerticalAlignment="Top"
              Width="300" Height="10"
              Background="Transparent"
              MouseEnter="Window_MouseEnter"
              MouseLeave="Window_MouseLeave"
              PreviewMouseWheel="IslandBody_PreviewMouseWheel">

            <Rectangle x:Name="PillShape"
                       Width="120" Height="8"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       RadiusX="4" RadiusY="4"
                       Fill="{DynamicResource Kobold.Brush.IslandBackground}"
                       Stroke="{DynamicResource Kobold.Brush.IslandBorder}" StrokeThickness="1"
                       Cursor="Hand"
                       MouseLeftButtonDown="Pill_MouseLeftButtonDown"
                       MouseMove="Pill_MouseMove"
                       MouseLeftButtonUp="Pill_MouseLeftButtonUp">
                <Rectangle.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.35" Direction="270"/>
                </Rectangle.Effect>
            </Rectangle>

            <!-- Three parts: fixed desktop entry | scrollable widget tiles |
                 fixed add + settings. Only the middle scrolls and it is capped
                 (IslandLayout), so the fixed entries can never scroll away. -->
            <StackPanel x:Name="IslandRow"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="Hidden">

                <!-- Desktop entry: single click toggles desktop icons, double click opens the folder -->
                <Border x:Name="DesktopTile" Width="44" Height="44" CornerRadius="8"
                        Background="Transparent" Cursor="Hand" Margin="0,0,8,0">
                    <Viewbox Width="30" Height="30">
                        <Grid Width="24" Height="24">
                            <icons:IconPresenter x:Name="DesktopTileIcon" Icon="Desktop" Size="24"
                                                 StrokeThickness="1.7"
                                                 Brush="{DynamicResource Kobold.Brush.IslandForeground}"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <!-- State overlay (not an icon): the slash marks hidden desktop icons. -->
                            <Path x:Name="DesktopSlash"
                                  Stroke="{DynamicResource Kobold.Brush.IslandForeground}"
                                  StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M 4.19,4.30 L 9.17,8.35 L 14.82,12.40 L 19.90,16.38"
                                  Visibility="Collapsed"/>
                        </Grid>
                    </Viewbox>
                </Border>

                <Rectangle x:Name="TileDivider" Width="1" Height="26" Margin="6,0,6,0"
                           VerticalAlignment="Center" Fill="{DynamicResource Kobold.Brush.IslandDivider}"/>

                <!-- Middle: one 44x44 tile per widget (added in code). The width is
                     set to IslandLayout.MiddleViewWidth, so the row clips here. -->
                <ScrollViewer x:Name="TileScroller"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Disabled"
                              CanContentScroll="False"
                              Focusable="False"
                              Visibility="Visible">
                    <StackPanel x:Name="TilePanel" Orientation="Horizontal"
                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </ScrollViewer>

                <!-- Settings entry: opens the settings window -->
                <Rectangle x:Name="SettingsDivider" Width="1" Height="26" Margin="6,0,6,0"
                           VerticalAlignment="Center" Fill="{DynamicResource Kobold.Brush.IslandDivider}"/>

                <!-- Add-widget entry: creates a widget with the default settings -->
                <Border x:Name="AddTile" Width="44" Height="44" CornerRadius="8"
                        Background="Transparent" Cursor="Hand" Margin="0,0,8,0">
                    <Viewbox Width="30" Height="30">
                        <icons:IconPresenter x:Name="AddTileIcon" Icon="Plus" Size="24"
                                             StrokeThickness="1.7"
                                             Brush="{DynamicResource Kobold.Brush.IslandForeground}"/>
                    </Viewbox>
                </Border>

                <Border x:Name="SettingsTile" Width="44" Height="44" CornerRadius="8"
                        Background="Transparent" Cursor="Hand">
                    <Viewbox Width="30" Height="30">
                        <icons:IconPresenter x:Name="SettingsTileIcon" Icon="Settings" Size="24"
                                             StrokeThickness="1.6"
                                             Brush="{DynamicResource Kobold.Brush.IslandForeground}"/>
                    </Viewbox>
                </Border>
            </StackPanel>

            <!-- Scroll hint for the middle section: the margins span exactly
                 between the fixed parts (12px padding + desktop entry on the
                 left, 12px padding + divider + add + settings on the right).
                 Shown by the code only while the tiles overflow. -->
            <ScrollBar x:Name="TileScrollBar"
                       Orientation="Horizontal"
                       Style="{StaticResource IslandScrollBarStyle}"
                       HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
                       Margin="77,0,121,2"
                       Maximum="0" SmallChange="52" LargeChange="52"
                       Visibility="Collapsed"/>
        </Grid>
    </Grid>
</Window>
