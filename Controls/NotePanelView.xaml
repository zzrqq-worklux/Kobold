<UserControl x:Class="Kobold.Controls.NotePanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             TextOptions.TextFormattingMode="Display"
             PreviewKeyDown="Root_PreviewKeyDown">

    <!-- The note content, the three states of spec 6.2 stacked on one surface:
         the list (top add row + card host), the reading view (header row + the
         rendered document) and the editing view (T14). Only one is visible at a
         time; the cards and the document are built in code. -->
    <Grid Margin="12,8,12,10" Background="Transparent">

        <!-- List state: the add row and the card host. Positioned first so the
             reading container draws over it. -->
        <Grid x:Name="ListHost">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Add row placeholder: the ＋ pill; the new-note flow (spec 6.3:
                 create an empty note straight into the editor) lands with T14. -->
            <Border x:Name="AddPill" Grid.Row="0" Height="30" CornerRadius="15" Margin="0,0,0,6"
                    Background="Transparent" BorderThickness="1" Cursor="Hand">
                <TextBlock x:Name="AddPillGlyph" Text="＋" FontSize="14"
                           Foreground="{DynamicResource Kobold.Brush.TextPrimary}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <!-- List host: the note cards are built here by the renderer. -->
            <ScrollViewer x:Name="ItemsScroller" Grid.Row="1"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          PanningMode="VerticalOnly" Background="Transparent">
                <StackPanel x:Name="ItemsPanel"/>
            </ScrollViewer>
        </Grid>

        <!-- Reading state: [back | elastic | edit] over the rendered document. -->
        <Grid x:Name="ReadingHost" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Height="26">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="ReadingBackButton" Grid.Column="0" Width="22" Height="22" CornerRadius="6"
                        Background="Transparent" Cursor="Hand" VerticalAlignment="Center"
                        MouseLeftButtonDown="ReadingBack_Click">
                    <TextBlock Text="‹" FontSize="14" Foreground="{DynamicResource Kobold.Brush.TextPrimary}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- The edit seam: T14 wires this to the source editor. -->
                <Border x:Name="ReadingEditButton" Grid.Column="2" Width="22" Height="22" CornerRadius="6"
                        Background="Transparent" Cursor="Hand" VerticalAlignment="Center">
                    <TextBlock Text="✎" FontSize="12" Foreground="{DynamicResource Kobold.Brush.TextPrimary}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>

            <!-- The document host. The box is read-only but document-enabled:
                 the task boxes and the hyperlinks inside it take the clicks
                 (spec 5.2/5.3). Its inner scroller stays disabled so this outer
                 one owns the offset the reading state restores after a toggle. -->
            <ScrollViewer x:Name="ReadingScroller" Grid.Row="1"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          PanningMode="VerticalOnly" Background="Transparent">
                <RichTextBox x:Name="ReadingBox" IsReadOnly="True" IsDocumentEnabled="True"
                             VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled"
                             Background="Transparent" BorderThickness="0" Padding="0"/>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
