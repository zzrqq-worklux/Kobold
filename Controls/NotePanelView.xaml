<UserControl x:Class="Kobold.Controls.NotePanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             TextOptions.TextFormattingMode="Display"
             PreviewKeyDown="Root_PreviewKeyDown">

    <!-- The note list, the whole panel: the top add row over the card host.
         One card at a time expands into the list itself (the panel carries one
         NoteSurfaceView, mounted in the expanded row's host border), so the list
         is the only surface the panel has - the rendered and the editing states
         live inside the expanded card, never over a separate view. -->
    <Grid x:Name="Root" Margin="12,8,12,10" Background="Transparent"
          MouseLeftButtonDown="Root_MouseLeftButtonDown">

        <Grid x:Name="ListHost">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Add row: the ＋ pill creates an empty note straight into its
                 whole-text edit (spec 6.3). -->
            <Border x:Name="AddPill" Grid.Row="0" Height="30" CornerRadius="15" Margin="0,0,0,6"
                    Background="Transparent" BorderThickness="1" Cursor="Hand"
                    MouseLeftButtonDown="AddPill_Click">
                <TextBlock x:Name="AddPillGlyph" Text="＋" FontSize="14"
                           Foreground="{DynamicResource Kobold.Brush.TextPrimary}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <!-- List host: the note rows are built here by the renderer - the
                 card faces and, for the expanded note, the surface's host. Its
                 inner scrollers are pass-throughs, so this scroller owns the
                 list's single scroll region. -->
            <ScrollViewer x:Name="ItemsScroller" Grid.Row="1"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          PanningMode="VerticalOnly" Background="Transparent">
                <StackPanel x:Name="ItemsPanel"/>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
