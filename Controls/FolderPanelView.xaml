<UserControl x:Class="Kobold.Controls.FolderPanelView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Kobold.Controls"
        xmlns:icons="clr-namespace:Kobold.Controls"
        AllowDrop="True" Background="Transparent"
        TextOptions.TextFormattingMode="Display">

    <!-- Task 3.1: the hand-built shell (border/header/lock/pin) is gone; the
         shared WidgetChrome draws it and owns the lock/pin/drag/right-click
         input. The chrome exposes its slots as public fields, which XAML
         cannot target with property-element syntax, so the folder content is
         declared in the SlotSource staging grid (same namescope, removed by
         the constructor) and moved into the chrome slots there. -->
    <Grid x:Name="RootGrid">
        <Grid x:Name="SlotSource" Visibility="Collapsed">

                <!-- Back: only visible while browsing a folder -->
                <Border x:Name="BackButton" Width="24" Height="24" CornerRadius="8"
                        Background="Transparent" Cursor="Hand"
                        BorderThickness="2" BorderBrush="Transparent"
                        AllowDrop="True"
                        DragOver="BackDrop_DragOver" DragLeave="BackDrop_DragLeave" Drop="BackDrop_Drop"
                        Margin="0,0,6,0" Visibility="Collapsed"
                        MouseLeftButtonDown="BackButton_Click">
                    <icons:IconPresenter x:Name="BackIcon" Icon="Chevron" Rotation="180"
                                         Size="13" StrokeThickness="1.9"
                                         Brush="{DynamicResource Kobold.Brush.IconFill}"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- Path menu: jump straight to any level of the current path (browse only) -->
                <Border x:Name="PathButton" Width="24" Height="24" CornerRadius="8"
                        Background="Transparent" Cursor="Hand" Margin="2,0,0,0"
                        VerticalAlignment="Center" Visibility="Collapsed"
                        ToolTipService.InitialShowDelay="250"
                        MouseLeftButtonDown="PathButton_MouseDown"
                        MouseLeftButtonUp="PathButton_MouseUp">
                    <icons:IconPresenter x:Name="PathIcon" Icon="Chevron" Rotation="90"
                                         Size="11" StrokeThickness="1.8"
                                         Brush="{DynamicResource Kobold.Brush.IconFill}"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- Help: what the item badges mean (hover) -->
                <Border x:Name="HelpButton"
                        Width="24" Height="24" CornerRadius="8"
                        Background="Transparent" Cursor="Help"
                        VerticalAlignment="Center" Margin="8,0,0,0"
                        MouseLeftButtonDown="HelpButton_Click"
                        ToolTipService.InitialShowDelay="250"
                        ToolTipService.ShowDuration="20000">
                    <icons:IconPresenter x:Name="HelpIcon" Icon="Help" Size="14" StrokeThickness="1.7"
                                         Brush="{DynamicResource Kobold.Brush.IconFill}"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Border.ToolTip>
                        <ToolTip>
                            <StackPanel MaxWidth="280">
                                <TextBlock x:Name="BadgeHelpTitle" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <icons:IconPresenter Icon="Archive" Size="14"
                                                         Brush="{DynamicResource Kobold.Brush.Accent}"
                                                         VerticalAlignment="Top" Margin="0,1,8,0"/>
                                    <TextBlock x:Name="BadgeHelpStored" TextWrapping="Wrap" MaxWidth="230"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="16" Height="16" CornerRadius="8" Background="{DynamicResource Kobold.Brush.MissingBadge}"
                                            VerticalAlignment="Top" Margin="0,1,8,0">
                                        <icons:IconPresenter Icon="Alert" Size="11" StrokeThickness="1.8"
                                                             Brush="{DynamicResource Kobold.Brush.OnAccent}"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock x:Name="BadgeHelpMissing" TextWrapping="Wrap" MaxWidth="230"/>
                                </StackPanel>
                            </StackPanel>
                        </ToolTip>
                    </Border.ToolTip>
                </Border>

                <!-- Files grid + empty state (both live in the chrome's content row) -->
                <Grid x:Name="ContentPanel" AllowDrop="True" Background="Transparent"
                      DragOver="ContentPanel_DragOver" DragLeave="ContentPanel_DragLeave"
                      Drop="ContentPanel_Drop">
                    <!-- Items - scrolls when the listing is taller than the panel cap -->
                    <ScrollViewer x:Name="ItemsScroller"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  PanningMode="VerticalOnly"
                                  AllowDrop="True"
                                  Background="Transparent">
                        <Grid x:Name="ItemsHost" Background="Transparent">
                            <ItemsControl x:Name="ItemsContainer" Margin="8,4,8,8"
                                          AllowDrop="True" Background="Transparent"
                                          DragOver="ItemsContainer_DragOver"
                                          DragLeave="ItemsContainer_DragLeave"
                                          Drop="ItemsContainer_Drop"
                                          QueryContinueDrag="Panel_QueryContinueDrag"
                                          MouseLeftButtonDown="ItemsContainer_MouseLeftButtonDown"
                                          MouseMove="ItemsContainer_MouseMove"
                                          MouseLeftButtonUp="ItemsContainer_MouseLeftButtonUp">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="ItemBorder" Width="72" Height="85" Margin="2" CornerRadius="8" 
                                                Background="Transparent" Cursor="Hand"
                                                BorderThickness="2" BorderBrush="Transparent"
                                                AllowDrop="True"
                                                DragOver="BrowseItem_DragOver" DragLeave="BrowseItem_DragLeave" Drop="BrowseItem_Drop"
                                                MouseEnter="Item_MouseEnter" MouseLeave="Item_MouseLeave"
                                                MouseLeftButtonDown="Item_MouseDown"
                                                MouseLeftButtonUp="Item_MouseUp"
                                                MouseMove="Item_MouseMove"
                                                MouseRightButtonUp="Item_RightClick">
                                            <Grid>
                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    <Border Width="40" Height="40" CornerRadius="8">
                                                        <Image x:Name="ItemIconImage" Source="{Binding Icon}" Stretch="Uniform"/>
                                                    </Border>
                                                    <!-- Normal, not Medium: Medium exists in neither Segoe UI
                                                         nor Microsoft YaHei UI, so Latin names would resolve to
                                                         Semibold while Chinese names fell back to Regular. -->
                                                    <TextBlock x:Name="ItemNameText" Text="{Binding Name}" FontSize="11"
                                                               Foreground="{Binding TextColor}"
                                                               TextTrimming="CharacterEllipsis" TextAlignment="Center"
                                                               MaxWidth="70" Margin="0,6,0,0" 
                                                               FontFamily="Segoe UI" FontWeight="Normal"/>
                                                </StackPanel>
                                                <!-- Stored badge: the file physically lives in Kobold storage -->
                                                <Border x:Name="StoredBadge" Width="16" Height="16"
                                                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,2,0"
                                                        Visibility="Collapsed">
                                                    <icons:IconPresenter x:Name="StoredBadgeIcon" Icon="Archive" Size="14"
                                                                         Brush="{DynamicResource Kobold.Brush.Accent}"
                                                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <!-- Missing badge: source file no longer exists -->
                                                <Border x:Name="MissingBadge" Width="16" Height="16" CornerRadius="8"
                                                        HorizontalAlignment="Left" VerticalAlignment="Top" Margin="2,2,0,0"
                                                        Background="{DynamicResource Kobold.Brush.MissingBadge}" Visibility="Collapsed">
                                                    <icons:IconPresenter x:Name="MissingBadgeIcon" Icon="Alert" Size="11"
                                                                         StrokeThickness="1.8"
                                                                         Brush="{DynamicResource Kobold.Brush.OnAccent}"
                                                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <!-- Both keys are overridden on the chrome's Shell from
                                                     the widget's colour (fix round 15, R3), so the selection
                                                     repaints on a live colour change; the app-level
                                                     SelectionFill stays as the blue fallback. -->
                                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource Kobold.Brush.SelectionBorder}"/>
                                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource Kobold.Brush.SelectionFill}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsStored}" Value="True">
                                                <Setter TargetName="StoredBadge" Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                                <Setter TargetName="ItemIconImage" Property="Opacity" Value="0.35"/>
                                                <Setter TargetName="ItemNameText" Property="Foreground" Value="{DynamicResource Kobold.Brush.TextMuted}"/>
                                                <Setter TargetName="MissingBadge" Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <local:BindableUniformGrid x:Name="ItemsGrid" 
                                            BindableColumns="{Binding GridColumns, RelativeSource={RelativeSource AncestorType=local:FolderPanelView}}"
                                            VerticalAlignment="Top"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            
                            <!-- Drop Indicator Line -->
                            <Rectangle x:Name="DropIndicator" 
                                       Width="3" Height="70"
                                       Fill="{DynamicResource Kobold.Brush.DropIndicator}"
                                       RadiusX="1.5" RadiusY="1.5"
                                       HorizontalAlignment="Left" VerticalAlignment="Top"
                                       Visibility="Collapsed"
                                       IsHitTestVisible="False">
                                <Rectangle.Effect>
                                    <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="White" Opacity="0.6"/>
                                </Rectangle.Effect>
                            </Rectangle>
                            
                            <!-- Selection Rectangle for lasso select -->
                            <Rectangle x:Name="SelectionRect" 
                                       Fill="{DynamicResource Kobold.Brush.LassoFill}" Stroke="{DynamicResource Kobold.Brush.LassoStroke}" StrokeThickness="1"
                                       HorizontalAlignment="Left" VerticalAlignment="Top"
                                       Visibility="Collapsed" IsHitTestVisible="False"/>
                        </Grid>
                    </ScrollViewer>
                    
                    <!-- Empty State -->
                    <StackPanel x:Name="EmptyState"
                                VerticalAlignment="Center" HorizontalAlignment="Center"
                                IsHitTestVisible="False"
                                Visibility="Collapsed">
                        <icons:IconPresenter x:Name="EmptyFolderIcon" Icon="Folder" Size="32"
                                             Brush="{DynamicResource Kobold.Brush.IconFill}"
                                             HorizontalAlignment="Center" Opacity="0.6"/>
                        <TextBlock x:Name="EmptyText" Text="Drop files here" 
                                   Foreground="{DynamicResource Kobold.Brush.TextFaint}" FontSize="11" FontFamily="Segoe UI"
                                   Margin="0,6,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- Truncated listing hint (browse mode only) -->
                <TextBlock x:Name="MoreItemsText" Margin="12,0,12,8"
                           FontSize="11" FontFamily="Segoe UI"
                           Background="Transparent"
                           Foreground="{DynamicResource Kobold.Brush.TextFaint}"
                           TextTrimming="CharacterEllipsis" HorizontalAlignment="Left"
                           Cursor="Hand" Visibility="Collapsed"
                           MouseLeftButtonUp="MoreItemsText_MouseLeftButtonUp"/>
        </Grid>
    </Grid>
</UserControl>
