<Window x:Class="Kobold.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kobold Settings" 
        Icon="pack://application:,,,/Kobold;component/Resources/icon.png"
        Width="420" Height="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize">
    
    <Border CornerRadius="{StaticResource Kobold.Radius.Window}"
            Background="{DynamicResource Kobold.Brush.Background}"
            BorderBrush="{DynamicResource Kobold.Brush.Border}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.6" Color="Black"/>
        </Border.Effect>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>
            
            <!-- Title Bar -->
            <Border Grid.Row="0" CornerRadius="12,12,0,0" Background="{DynamicResource Kobold.Brush.Surface}" 
                    MouseLeftButtonDown="TitleBar_MouseDown">
                <Grid>
                    <TextBlock x:Name="SettingsHeaderText" Text="⚙️ Settings" 
                               Foreground="{DynamicResource Kobold.Brush.TextPrimary}"
                               FontSize="{StaticResource Kobold.Font.Subtitle}" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="20,0,0,0" FontFamily="Segoe UI"/>
                    
                    <Button x:Name="CloseButton" Content="✕" 
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Width="36" Height="36" Margin="0,0,8,0"
                            FontSize="14"
                            Style="{StaticResource Kobold.Style.CloseButton}"
                            Click="CloseButton_Click"/>
                </Grid>
            </Border>
            
            <!-- Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,16">
                <StackPanel>
                    
                    <!-- Language Section -->
                    <TextBlock x:Name="LanguageHeader" Text="🌐 Language" 
                               Foreground="{DynamicResource Kobold.Brush.TextPrimary}" 
                               FontSize="{StaticResource Kobold.Font.Subtitle}" FontWeight="SemiBold" Margin="0,0,0,12" FontFamily="Segoe UI"/>
                    
                    <Border Background="{DynamicResource Kobold.Brush.Surface}" CornerRadius="{StaticResource Kobold.Radius.Control}" Padding="16,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="LanguageLabel" Text="Interface Language" 
                                       Foreground="{DynamicResource Kobold.Brush.TextSecondary}" 
                                       VerticalAlignment="Center" FontFamily="Segoe UI"/>
                            <ComboBox x:Name="LanguageCombo" Grid.Column="1" Width="140" 
                                      SelectionChanged="LanguageCombo_SelectionChanged">
                                <ComboBoxItem Content="English" Tag="en"/>
                                <ComboBoxItem Content="简体中文" Tag="zh"/>
                                <ComboBoxItem Content="日本語" Tag="ja"/>
                            </ComboBox>
                        </Grid>
                    </Border>
                    
                    <!-- Theme Section -->
                    <TextBlock x:Name="ThemeHeader" Text="🎨 Theme" 
                               Foreground="{DynamicResource Kobold.Brush.TextPrimary}" 
                               FontSize="{StaticResource Kobold.Font.Subtitle}" FontWeight="SemiBold" Margin="0,24,0,12" FontFamily="Segoe UI"/>
                    
                    <Border Background="{DynamicResource Kobold.Brush.Surface}" CornerRadius="{StaticResource Kobold.Radius.Control}" Padding="16,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ThemeLabel" Text="Color Theme" 
                                       Foreground="{DynamicResource Kobold.Brush.TextSecondary}" 
                                       VerticalAlignment="Center" FontFamily="Segoe UI"/>
                            <ComboBox x:Name="ThemeCombo" Grid.Column="1" Width="140"
                                      SelectionChanged="ThemeCombo_SelectionChanged">
                                <ComboBoxItem x:Name="ThemeDark" Content="🌙 Dark" Tag="dark"/>
                                <ComboBoxItem x:Name="ThemeLight" Content="☀️ Light" Tag="light"/>
                            </ComboBox>
                        </Grid>
                    </Border>
                    
                    <!-- Widget Defaults Section -->
                    <TextBlock x:Name="DefaultsHeader" Text="📊 Widget Defaults" 
                               Foreground="{DynamicResource Kobold.Brush.TextPrimary}" 
                               FontSize="{StaticResource Kobold.Font.Subtitle}" FontWeight="SemiBold" Margin="0,24,0,12" FontFamily="Segoe UI"/>
                    
                    <Border Background="{DynamicResource Kobold.Brush.Surface}" CornerRadius="{StaticResource Kobold.Radius.Control}" Padding="16,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="GridLabel" Text="Default Grid Columns" 
                                       Foreground="{DynamicResource Kobold.Brush.TextSecondary}" 
                                       VerticalAlignment="Center" FontFamily="Segoe UI"/>
                            <ComboBox x:Name="GridColumnsCombo" Grid.Column="1" Width="80"
                                      SelectionChanged="GridColumnsCombo_SelectionChanged">
                                <ComboBoxItem Content="2" Tag="2"/>
                                <ComboBoxItem Content="3" Tag="3"/>
                                <ComboBoxItem Content="4" Tag="4"/>
                                <ComboBoxItem Content="5" Tag="5"/>
                                <ComboBoxItem Content="6" Tag="6"/>
                            </ComboBox>
                        </Grid>
                    </Border>
                    
                    <!-- Storing Behaviour -->
                    <Border Background="{DynamicResource Kobold.Brush.Surface}" CornerRadius="{StaticResource Kobold.Radius.Control}" Padding="16,12" Margin="0,12,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="HideDesktopLabel" Text="Hide source files on desktop after storing" 
                                       Foreground="{DynamicResource Kobold.Brush.TextSecondary}" VerticalAlignment="Center" TextWrapping="Wrap"
                                       FontFamily="Segoe UI"/>
                            <CheckBox x:Name="HideDesktopCheckbox" Grid.Column="1" VerticalAlignment="Center"
                                      Margin="12,0,0,0"
                                      Checked="HideDesktopCheckbox_Changed" Unchecked="HideDesktopCheckbox_Changed"/>
                        </Grid>
                    </Border>
                    
                    <!-- Panel Appearance -->
                    <Border Background="{DynamicResource Kobold.Brush.Surface}" CornerRadius="{StaticResource Kobold.Radius.Control}" Padding="16,12" Margin="0,12,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="PanelOpacityLabel" Text="Panel Opacity" 
                                           Foreground="{DynamicResource Kobold.Brush.TextSecondary}" FontFamily="Segoe UI"/>
                                <TextBlock x:Name="PanelOpacityValue" Text="100%" 
                                           Foreground="{DynamicResource Kobold.Brush.TextMuted}" 
                                           FontSize="{StaticResource Kobold.Font.Caption}" Margin="0,2,0,0" FontFamily="Segoe UI"/>
                            </StackPanel>
                            <Slider x:Name="PanelOpacitySlider" Grid.Column="1" Width="140" Minimum="20" Maximum="100"
                                    VerticalAlignment="Center" Margin="12,0,0,0" IsSnapToTickEnabled="True" TickFrequency="5"
                                    ValueChanged="PanelOpacitySlider_ValueChanged"/>
                        </Grid>
                    </Border>
                    
                    <!-- Startup Section -->
                    <TextBlock x:Name="StartupHeader" Text="🚀 Startup" 
                               Foreground="{DynamicResource Kobold.Brush.TextPrimary}" 
                               FontSize="{StaticResource Kobold.Font.Subtitle}" FontWeight="SemiBold" Margin="0,24,0,12" FontFamily="Segoe UI"/>
                    <Border Background="{DynamicResource Kobold.Brush.Surface}" CornerRadius="{StaticResource Kobold.Radius.Control}" Padding="16,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="StartupLabel" Text="Start with Windows" 
                                           Foreground="{DynamicResource Kobold.Brush.TextSecondary}" FontFamily="Segoe UI"/>
                                <TextBlock x:Name="StartupNote" Text="" 
                                           Foreground="{DynamicResource Kobold.Brush.TextMuted}" 
                                           FontSize="{StaticResource Kobold.Font.Caption}" Margin="0,2,0,0" FontFamily="Segoe UI"/>
                            </StackPanel>
                            <CheckBox x:Name="StartupCheckbox" Grid.Column="1" VerticalAlignment="Center"
                                      IsEnabled="True" Checked="StartupCheckbox_Changed" Unchecked="StartupCheckbox_Changed"/>
                        </Grid>
                    </Border>
                    
                    <!-- Icon Style Section -->
                    <TextBlock x:Name="IconStyleHeader" Text="📁 Icon Style" 
                               Foreground="{DynamicResource Kobold.Brush.TextPrimary}" 
                               FontSize="{StaticResource Kobold.Font.Subtitle}" FontWeight="SemiBold" Margin="0,24,0,12" FontFamily="Segoe UI"/>
                    
                    <Border Background="{DynamicResource Kobold.Brush.Surface}" CornerRadius="{StaticResource Kobold.Radius.Control}" Padding="16,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="IconStyleLabel" Text="Folder Icon Style" 
                                       Foreground="{DynamicResource Kobold.Brush.TextSecondary}" 
                                       VerticalAlignment="Center" FontFamily="Segoe UI"/>
                            <ComboBox x:Name="IconStyleCombo" Grid.Column="1" Width="120"
                                      SelectionChanged="IconStyleCombo_SelectionChanged">
                                <ComboBoxItem Content="📂 Classic" Tag="classic"/>
                                <ComboBoxItem Content="✍️ Hand-drawn" Tag="handdrawn"/>
                            </ComboBox>
                        </Grid>
                    </Border>
                    
                    <!-- Kobold Storage Section -->
                    <TextBlock x:Name="StorageHeader" Text="📦 Kobold Storage"
                               Foreground="{DynamicResource Kobold.Brush.TextPrimary}"
                               FontSize="{StaticResource Kobold.Font.Subtitle}" FontWeight="SemiBold" Margin="0,24,0,12" FontFamily="Segoe UI"/>

                    <Border Background="{DynamicResource Kobold.Brush.Surface}" CornerRadius="{StaticResource Kobold.Radius.Control}" Padding="16,12">
                        <StackPanel>
                            <TextBlock x:Name="StoragePathText" Text=""
                                       Foreground="{DynamicResource Kobold.Brush.TextSecondary}"
                                       TextTrimming="CharacterEllipsis" FontFamily="Segoe UI"/>
                            <StackPanel x:Name="StorageButtonsRow" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                                <Button x:Name="StorageOpenButton" Content="Open folder" MinHeight="34" MinWidth="96" Padding="16,0" FontSize="12"
                                        Style="{StaticResource Kobold.Style.SecondaryButton}"
                                        Click="StorageOpenButton_Click"/>
                                <Button x:Name="StoragePinButton" Content="Pin to Quick Access" MinHeight="34" MinWidth="120" Padding="16,0" FontSize="12" Margin="8,0,0,0"
                                        Style="{StaticResource Kobold.Style.PrimaryButton}"
                                        Click="StoragePinButton_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- File Search Section -->
                    <TextBlock x:Name="FileSearchHeader" Text="🔎 File Search"
                               Foreground="{DynamicResource Kobold.Brush.TextPrimary}"
                               FontSize="{StaticResource Kobold.Font.Subtitle}" FontWeight="SemiBold" Margin="0,24,0,12" FontFamily="Segoe UI"/>

                    <Border Background="{DynamicResource Kobold.Brush.Surface}" CornerRadius="{StaticResource Kobold.Radius.Control}" Padding="16,12">
                        <StackPanel>
                            <TextBlock x:Name="FileSearchStatusText" Text="Status: —"
                                       Foreground="{DynamicResource Kobold.Brush.TextSecondary}"
                                       TextWrapping="Wrap" FontFamily="Segoe UI"/>
                            <TextBlock x:Name="FileSearchSizeText" Text=""
                                       Foreground="{DynamicResource Kobold.Brush.TextMuted}"
                                       FontSize="{StaticResource Kobold.Font.Caption}" Margin="0,2,0,0" FontFamily="Segoe UI"/>
                            <TextBlock x:Name="FileSearchLastUpdatedText" Text=""
                                       Foreground="{DynamicResource Kobold.Brush.TextMuted}"
                                       FontSize="{StaticResource Kobold.Font.Caption}" Margin="0,2,0,0" FontFamily="Segoe UI"/>

                            <CheckBox x:Name="FileSearchAllFilesCheck" Content="All files"
                                      Foreground="{DynamicResource Kobold.Brush.TextSecondary}"
                                      Margin="0,10,0,0" FontFamily="Segoe UI"/>
                            <CheckBox x:Name="FileSearchExtensionlessCheck" Content="Extensionless files"
                                      Foreground="{DynamicResource Kobold.Brush.TextSecondary}"
                                      Margin="0,6,0,0" FontFamily="Segoe UI"/>
                            <CheckBox x:Name="FileSearchFoldersCheck" Content="Index folders"
                                      Foreground="{DynamicResource Kobold.Brush.TextSecondary}"
                                      Margin="0,6,0,0" FontFamily="Segoe UI"/>

                            <TextBlock x:Name="FileSearchTypesLabel" Text="File types (comma separated)"
                                       Foreground="{DynamicResource Kobold.Brush.TextSecondary}"
                                       Margin="0,12,0,4" FontFamily="Segoe UI"/>
                            <TextBox x:Name="FileSearchTypesBox" TextWrapping="Wrap"/>

                            <TextBlock x:Name="FileSearchExcludesLabel" Text="Extra excluded folders (one per line)"
                                       Foreground="{DynamicResource Kobold.Brush.TextSecondary}"
                                       Margin="0,12,0,4" FontFamily="Segoe UI"/>
                            <TextBox x:Name="FileSearchExcludesBox" AcceptsReturn="True" Height="54"
                                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>

                            <TextBlock x:Name="FileSearchReconcileLabel" Text="Reconcile every (minutes, 0 = off)"
                                       Foreground="{DynamicResource Kobold.Brush.TextSecondary}"
                                       Margin="0,12,0,4" FontFamily="Segoe UI"/>
                            <TextBox x:Name="FileSearchReconcileBox" Width="60" HorizontalAlignment="Left"/>

                            <TextBlock x:Name="FileSearchRootsLabel" Text="Indexed drives"
                                       Foreground="{DynamicResource Kobold.Brush.TextSecondary}"
                                       Margin="0,12,0,4" FontFamily="Segoe UI"/>
                            <ItemsControl x:Name="FileSearchRootsList"/>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                                <Button x:Name="FileSearchRebuildButton" Content="Rebuild now" MinHeight="32" MinWidth="96" Padding="16,0" FontSize="12"
                                        Style="{StaticResource Kobold.Style.SecondaryButton}"
                                        Click="FileSearchRebuildButton_Click"/>
                                <Button x:Name="FileSearchPauseButton" Content="Pause" MinHeight="32" MinWidth="80" Padding="16,0" FontSize="12" Margin="8,0,0,0"
                                        Style="{StaticResource Kobold.Style.SecondaryButton}"
                                        Click="FileSearchPauseButton_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Island Section -->
                    <TextBlock x:Name="IslandHeader" Text="🏝️ Island" 
                               Foreground="{DynamicResource Kobold.Brush.TextPrimary}" 
                               FontSize="{StaticResource Kobold.Font.Subtitle}" FontWeight="SemiBold" Margin="0,24,0,12" FontFamily="Segoe UI"/>
                    
                    <Border Background="{DynamicResource Kobold.Brush.Surface}" CornerRadius="{StaticResource Kobold.Radius.Control}" Padding="16,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="IslandDelayLabel" Text="Auto-collapse delay" 
                                           Foreground="{DynamicResource Kobold.Brush.TextSecondary}" FontFamily="Segoe UI"/>
                                <TextBlock x:Name="IslandDelayValue" Text="1.0s" 
                                           Foreground="{DynamicResource Kobold.Brush.TextMuted}" 
                                           FontSize="{StaticResource Kobold.Font.Caption}" Margin="0,2,0,0" FontFamily="Segoe UI"/>
                            </StackPanel>
                            <Slider x:Name="IslandDelaySlider" Grid.Column="1" Width="140" Minimum="30" Maximum="500"
                                    VerticalAlignment="Center" Margin="12,0,0,0" IsSnapToTickEnabled="True" TickFrequency="10"
                                    ValueChanged="IslandDelaySlider_ValueChanged"/>
                        </Grid>
                    </Border>
                    
                    <!-- About Section -->
                    <TextBlock x:Name="AboutHeaderText" Text="ℹ️ About" 
                               Foreground="{DynamicResource Kobold.Brush.TextPrimary}" 
                               FontSize="{StaticResource Kobold.Font.Subtitle}" FontWeight="SemiBold" Margin="0,24,0,12" FontFamily="Segoe UI"/>
                    
                    <Border Background="{DynamicResource Kobold.Brush.Surface}" CornerRadius="{StaticResource Kobold.Radius.Control}" Padding="16,12">
                        <StackPanel>
                            <TextBlock Text="Kobold" 
                                       Foreground="{DynamicResource Kobold.Brush.TextPrimary}" 
                                       FontSize="{StaticResource Kobold.Font.Title}" FontWeight="Bold" FontFamily="Segoe UI"/>
                            <TextBlock x:Name="AboutTaglineText" Text="Desktop Folder Widgets" 
                                       Foreground="{DynamicResource Kobold.Brush.TextMuted}" 
                                       FontSize="{StaticResource Kobold.Font.Caption}" Margin="0,2,0,0" FontFamily="Segoe UI"/>
                            <TextBlock x:Name="VersionText" Text="Version 1.0.0" 
                                       Foreground="{DynamicResource Kobold.Brush.TextMuted}" 
                                       FontSize="{StaticResource Kobold.Font.Caption}" Margin="0,8,0,0" FontFamily="Segoe UI"/>
                        </StackPanel>
                    </Border>
                    
                </StackPanel>
            </ScrollViewer>
            
            <!-- Footer -->
            <Border Grid.Row="2" CornerRadius="0,0,12,12" Background="{DynamicResource Kobold.Brush.Surface}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0">
                    <Button x:Name="SaveButton" Content="Save" Width="90" Height="32" Margin="0,0,8,0"
                            Style="{StaticResource Kobold.Style.PrimaryButton}"
                            Click="SaveButton_Click"/>
                    <Button x:Name="CancelButton" Content="Cancel" Width="90" Height="32"
                            Style="{StaticResource Kobold.Style.SecondaryButton}"
                            Click="CancelButton_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
