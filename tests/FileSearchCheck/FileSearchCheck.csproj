<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>Kobold.FileSearchCheck</AssemblyName>
    <RootNamespace>Kobold.FileSearchCheck</RootNamespace>
    <!-- SQLitePCLRaw copies the native DLL that matches this project's platform.
         AnyCPU gets win-x86, which a 64-bit process cannot load (BadImageFormatException);
         the app itself is pinned to x64 in Kobold.csproj. -->
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Kobold.csproj" />
  </ItemGroup>
</Project>
