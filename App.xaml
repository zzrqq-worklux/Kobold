<Application x:Class="Kobold.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="clr-namespace:Kobold.Controls"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Floating surfaces (menus, tooltips) follow the active theme;
                 their brushes are installed by ThemeManager. -->

            <!-- Dark ContextMenu -->
            <Style TargetType="{x:Type ContextMenu}">
                <Setter Property="OverridesDefaultStyle" Value="True"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="Foreground" Value="{DynamicResource Kobold.Brush.OverlayText}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ContextMenu}">
                            <Grid Background="Transparent" Margin="10">
                                <Border x:Name="Surface" Background="{DynamicResource Kobold.Brush.OverlayBackground}"
                                        BorderBrush="{DynamicResource Kobold.Brush.OverlayBorder}" BorderThickness="1"
                                        CornerRadius="10" Padding="6">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="12" ShadowDepth="5" Opacity="0.40" Color="Black" RenderingBias="Quality"/>
                                    </Border.Effect>
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                </Border>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Dark Separator -->
            <Style TargetType="{x:Type Separator}">
                <Setter Property="OverridesDefaultStyle" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Separator}">
                            <Border x:Name="Line" Height="1" Margin="30,5,30,5" Background="{DynamicResource Kobold.Brush.OverlayDivider}"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Dark MenuItem - Complete Override -->
            <Style TargetType="{x:Type MenuItem}">
                <Setter Property="OverridesDefaultStyle" Value="True"/>
                <Setter Property="Foreground" Value="{DynamicResource Kobold.Brush.OverlayText}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type MenuItem}">
                            <Border x:Name="Bg" Background="Transparent" Padding="0">
                                <Border x:Name="Pill" Margin="0,1" CornerRadius="8" Padding="9,0" MinHeight="32"
                                        Background="Transparent">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <!-- 26 = 16px icon + 10px gap. There is NO separate
                                                 check column: the check shares this slot and replaces
                                                 the icon when an item is checked, so unchecked menus
                                                 do not reserve an empty 18px gutter. -->
                                            <ColumnDefinition Width="26"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- Icon slot: every menu icon is an IconPresenter, so the
                                             classic/hand-drawn switch is automatic. -->
                                        <ContentPresenter x:Name="IconHost" Grid.Column="0" ContentSource="Icon"
                                                          Width="16" Height="16" Margin="0"
                                                          HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                        <!-- Checked state: the same clay check as the hand-drawn controls. -->
                                        <icons:IconPresenter x:Name="Check" Grid.Column="0" Icon="Check" Size="12"
                                                             StrokeThickness="1.8"
                                                             Brush="{DynamicResource Kobold.Brush.Accent}"
                                                             VerticalAlignment="Center" HorizontalAlignment="Left"
                                                             Visibility="Collapsed"/>
                                        <ContentPresenter x:Name="HeaderHost" Grid.Column="1" ContentSource="Header"
                                                          VerticalAlignment="Center" RecognizesAccessKey="True"/>
                                        <icons:IconPresenter x:Name="Arrow" Grid.Column="2" Icon="Chevron" Size="12"
                                                             StrokeThickness="1.7"
                                                             Brush="{DynamicResource Kobold.Brush.OverlayMuted}"
                                                             Margin="12,0,0,0" VerticalAlignment="Center"
                                                             Visibility="Collapsed"/>
                                        <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False"
                                               IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                               Placement="Right" HorizontalOffset="-12" VerticalOffset="-14">
                                            <Grid Background="Transparent" Margin="10">
                                                <Border Background="{DynamicResource Kobold.Brush.OverlayBackground}"
                                                        BorderBrush="{DynamicResource Kobold.Brush.OverlayBorder}" BorderThickness="1"
                                                        CornerRadius="10" Padding="6">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="12" ShadowDepth="5" Opacity="0.40" Color="Black" RenderingBias="Quality"/>
                                                    </Border.Effect>
                                                    <StackPanel IsItemsHost="True"/>
                                                </Border>
                                            </Grid>
                                        </Popup>
                                    </Grid>
                                </Border>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="Pill" Property="Background" Value="{DynamicResource Kobold.Brush.OverlayHover}"/>
                                </Trigger>
                                <Trigger Property="HasItems" Value="True">
                                    <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Pill" Property="Background" Value="{DynamicResource Kobold.Brush.OverlayChecked}"/>
                                    <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="IconHost" Property="Visibility" Value="Collapsed"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Pill" Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Dark ToolTip - shown below its target, consistent with the menus -->
            <Style TargetType="{x:Type ToolTip}">
                <Setter Property="OverridesDefaultStyle" Value="True"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="Foreground" Value="{DynamicResource Kobold.Brush.OverlayText}"/>
                <Setter Property="Placement" Value="Bottom"/>
                <Setter Property="VerticalOffset" Value="6"/>
                <Setter Property="MaxWidth" Value="320"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ToolTip}">
                            <Border Background="{DynamicResource Kobold.Brush.TooltipBackground}"
                                    BorderBrush="{DynamicResource Kobold.Brush.TooltipBorder}" BorderThickness="1"
                                    CornerRadius="8" Padding="10,8">
                                <ContentPresenter/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
