<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>7.3</LangVersion>
    <AssemblyTitle>Kobold</AssemblyTitle>
    <Product>Kobold</Product>
    <Version>1.0.1</Version>
    <Description>Desktop Folder Widgets</Description>
    <Copyright>Copyright 2025 YusufEren97</Copyright>
    <ApplicationIcon>Resources\icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <!-- Icons are embedded as WPF resources; the tray icon loads them via pack URI -->
    <Resource Include="Resources\icon.ico" />
    <Resource Include="Resources\icon.png" />
    <!-- Grab cursors (MIT, see Resources\cursors.LICENSE.txt) -->
    <Resource Include="Resources\cursor_open.cur" />
    <Resource Include="Resources\cursor_grab.cur" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="1.1.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>
  <ItemGroup>
    <!-- tests/ holds separate projects; keep them out of the WPF app build -->
    <Compile Remove="tests\**\*.cs" />
    <EmbeddedResource Remove="tests\**\*" />
    <None Remove="tests\**\*" />
  </ItemGroup>
</Project>
